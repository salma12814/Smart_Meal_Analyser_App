# Copy to .env at the repository root and replace both values.
# DATABASE_PASSWORD must match the PostgreSQL account configured below.
DATABASE_USERNAME=smeal_user
DATABASE_PASSWORD=replace-with-your-postgres-password
JWT_SECRET=replace-with-a-cryptographically-random-secret-of-at-least-32-bytes

# Optional overrides for local services
DATABASE_URL=jdbc:postgresql://localhost:5433/smeal_db
REDIS_HOST=localhost
REDIS_PORT=6379
ML_API_URL=http://localhost:5000
